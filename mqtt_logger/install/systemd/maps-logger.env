# MAPS Value Logger configuration
# Edit this file, then run: systemctl start maps-logger
# To override individual values without editing this file: systemctl edit maps-logger

# Required: MQTT broker URL. Use ssl://host:port for TLS / mutual TLS.
# The logger requests the Message-JSON transformation itself (in its MQTT client
# id), so no server-wide transformation rule is needed.
MAPS_LOGGER_URL=tcp://127.0.0.1:1883

# Topic filter(s) to subscribe to; separate several filters with commas,
# e.g. 4817/#,/tak/cot/#
# NOTE: `#` matches EVERY topic; `/#` only matches slash-prefixed topic names
# and silently misses e.g. `4817/catl/...` (proven in the field).
MAPS_LOGGER_TOPIC=#

# MQTT QoS level: 0, 1, or 2
MAPS_LOGGER_QOS=1

# Output format: csv or json  (json output files use the .ndjson extension)
MAPS_LOGGER_FORMAT=json

# Directory for hourly output files (created automatically if absent)
MAPS_LOGGER_OUTPUT_DIR=/var/log/maps-logger

# Warn to system log when free space on the output filesystem falls below this many MB
MAPS_LOGGER_DISK_WARN_MB=500

# Delete compressed log files older than this many days (0 = keep forever).
# Applied by the hourly maps-logger-compress timer after compression.
MAPS_LOGGER_RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# Authentication and TLS (all optional)
#
# Secrets are always read from files, never from this env file. Keep them in
# /etc/maps-logger/credentials/ owned root:maps-logger with mode 0640, e.g.
#   install -m 0640 -o root -g maps-logger /dev/stdin /etc/maps-logger/credentials/mqtt-password
# Files are re-read on every reconnect, so rotating a secret needs no restart.
# ---------------------------------------------------------------------------

# Broker account. MAPS_LOGGER_PASSWORD_FILE requires MAPS_LOGGER_USERNAME.
#MAPS_LOGGER_USERNAME=maps-logger
#MAPS_LOGGER_PASSWORD_FILE=/etc/maps-logger/credentials/mqtt-password

# Client certificate for mutual TLS (PKCS12 or JKS). Requires an ssl:// URL.
#MAPS_LOGGER_KEYSTORE=/etc/maps-logger/credentials/logger-client.p12
#MAPS_LOGGER_KEYSTORE_PASSWORD_FILE=/etc/maps-logger/credentials/keystore-password

# Trust store holding the broker's certificate or CA. Requires an ssl:// URL.
# Without it the JVM's default trust store is used.
#MAPS_LOGGER_TRUSTSTORE=/etc/maps-logger/credentials/broker-trust.p12
#MAPS_LOGGER_TRUSTSTORE_PASSWORD_FILE=/etc/maps-logger/credentials/truststore-password
